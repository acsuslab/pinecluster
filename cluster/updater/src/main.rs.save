use std::{
    fs::File,
    io::{self, BufRead},
    process::Command,
    time::SystemTime
};

fn main() -> io::Result<()> {
    let nodes = read_nodes("nodelist")?;
    
    for node in nodes {
        println!("Processing: {}", node);
        update_node(&node)?;
    }
    Ok(())
}

fn update_node(node: &str) -> io::Result<()> {
    // Stop service
    ssh_execute(node, "pkill -f start_service || true")?;

    // Archive old version
    let timestamp = SystemTime::now()
        .duration_since(SystemTime::UNIX_EPOCH)
        .unwrap()
        .as_secs();
    
    ssh_execute(node, &format!(
        "mkdir -p Node/target/release/versions && \
         mv Node/target/release/start_service Node/target/release/versions/start_service_{} || true", 
        timestamp
    ))?;

    // Upload new binary
    Command::new("scp")
        .args([
            "-i", "rpi.key",
            "target/release/start_service",
            &format!("{}:~/Node/target/release/", node)
        ])
        .status()?;

    // Start new service
    ssh_execute(node, "chmod +x Node/target/release/start_service && nohup Node/target/release/start_service > service.log 2>&1 &")?;

    Ok(())
}

// Helper functions
        .map(|l| l.map(|s| s.trim().to_string()))
        .collect()
}

fn ssh_execute(node: &str, cmd: &str) -> io::Result<()> {
    Command::new("ssh")
        .args([
            "-i", "rpi.key",
            "-o", "StrictHostKeyChecking=no",
            node,
            cmd
        ])
        .status()?;
    Ok(())
}


